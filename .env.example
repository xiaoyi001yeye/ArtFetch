# 上游雅昌检索地址
ARTWORK_SOURCE_URL=https://artso.artron.net/auction/search_auction.php
REQUEST_DELAY_MS=300

# PostgreSQL 连接。生产环境必须改成强密码，并只保存在服务器 .env 中。
POSTGRES_DB=artfetch
POSTGRES_USER=artfetch
POSTGRES_PASSWORD=change-me-db-password

# 端口绑定。生产环境默认只把 PostgreSQL 和后端绑定到服务器本机。
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=8080
FRONTEND_PORT=3000
JUPYTER_BIND_HOST=127.0.0.1
JUPYTER_PORT=8888

# 制品化生产部署镜像由安装/升级脚本写入服务器 .env.release，不要写入 .env。
# .env.release 包含 POSTGRES_IMAGE、ARTFETCH_BACKEND_IMAGE、ARTFETCH_FRONTEND_IMAGE、ARTFETCH_JUPYTER_IMAGE。

# ArtFetch 应用管理员。仅在用户表为空时初始化，生产环境必须改成强密码。
ARTFETCH_ADMIN_USERNAME=admin
ARTFETCH_ADMIN_PASSWORD=change-me-admin-password

# 雅昌认证信息。可二选一：直接填 Cookie，或填账号密码由后端登录获取。
ARTFETCH_AUTH_ARTRON_COOKIE=
ARTFETCH_AUTH_ARTRON_ACCOUNT=
ARTFETCH_AUTH_ARTRON_PASSWORD=

# 高清大图对象存储。LOCAL_ONLY=仅本地，LOCAL_AND_OBJECT=本地+火山TOS，OBJECT_ONLY=仅火山TOS。
ARTFETCH_IMAGE_HD_STORAGE_MODE=LOCAL_ONLY
# 用于加密数据库中的火山 TOS Secret Key，生产环境必须改成稳定强随机值，修改后旧密文将无法解密。
ARTFETCH_OBJECT_STORAGE_ENCRYPTION_KEY=change-me-object-storage-encryption-key
